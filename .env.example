# Notion (befintlig)
NOTION_TOKEN=
NOTION_STANDUPS_PAGE_ID=

# Turso (CRM-databas)
TURSO_DATABASE_URL=libsql://stayonsite-crm-<org>.turso.io
TURSO_AUTH_TOKEN=

# Auth.js (Google OAuth)
AUTH_SECRET=   # generera med: openssl rand -hex 32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXTAUTH_URL=http://localhost:8080

# Cloudflare R2 (bostadsbilder) — R2 → Manage API Tokens → Create API Token (Object Read & Write)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=stayonsiteproperties

# Agent-/MCP-tokens (bearer). Generera med: openssl rand -hex 32. Fail-closed:
# är en token inte satt är motsvarande endpoint avstängd.
CRM_AGENT_TOKEN=       # Mac-agenten (scripts/imessage-agent.mjs) mot /api/crm/*/agent
CRM_MCP_TOKEN=         # MCP-servern /api/mcp — läsverktyg (AI-agenter)
CRM_MCP_WRITE_TOKEN=   # MCP-servern /api/mcp — läs + icke-destruktiva skrivverktyg

# Google Maps – adress-autocomplete i CRM (förfrågan). Aktivera "Maps JavaScript API" + "Places API".
# Lås nyckeln till HTTP-referrers: stayonsite.se/*, www.stayonsite.se/*, localhost:8080/*
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Ads – konverteringsspårning (gtag + Consent Mode v2).
# UTAN dessa laddas gtag.js aldrig och inga konverteringar registreras (lib/gtag.ts -> if (!GA_ADS_ID) return).
# ID:t hittas i Google Ads under Verktyg → Konverteringar; labels är send_to-delen efter snedstrecket.
NEXT_PUBLIC_GADS_ID=AW-17938262768
NEXT_PUBLIC_GADS_FORM_LABEL=KBG1CJHs8pUcEPDV0OlC   # "Skicka in formulär" (SUBMIT_LEAD_FORM)
NEXT_PUBLIC_GADS_CALL_LABEL=yQulCJay3JUcEPDV0OlC   # "Kontakt (1)" (telefon)
NEXT_PUBLIC_GADS_EMAIL_LABEL=HBe1COPOi8ocEPDV0OlC   # "E-post klick" (CONTACT)
NEXT_PUBLIC_GADS_WHATSAPP_LABEL=ys0KCOS8icocEPDV0OlC   # "WhatsApp klick" (CONTACT)
