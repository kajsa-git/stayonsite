# Notion (befintlig)
NOTION_TOKEN=
NOTION_STANDUPS_PAGE_ID=

# Turso (CRM-databas)
TURSO_DATABASE_URL=libsql://stayonsite-crm-<org>.turso.io
TURSO_AUTH_TOKEN=

# Auth.js (Google OAuth)
AUTH_SECRET=   # generera med: openssl rand -hex 32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXTAUTH_URL=http://localhost:8080

# Cloudflare R2 (bostadsbilder) — R2 → Manage API Tokens → Create API Token (Object Read & Write)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=stayonsiteproperties

# Google Maps – adress-autocomplete i CRM (förfrågan). Aktivera "Maps JavaScript API" + "Places API".
# Lås nyckeln till HTTP-referrers: stayonsite.se/*, www.stayonsite.se/*, localhost:8080/*
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
